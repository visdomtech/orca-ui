{
  "name": "@doublefin/orca-ui",
  "version": "1.4.2",
  "repository": "github:visdomtech/orca-ui",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./role-audit-prompt": {
      "types": "./dist/roleAuditPrompt.d.ts",
      "import": "./dist/roleAuditPrompt.js"
    },
    "./role-audit-runner": {
      "types": "./dist/roleAuditRunner.d.ts",
      "import": "./dist/roleAuditRunner.js"
    },
    "./org-chart": {
      "types": "./dist/OrgChart.d.ts",
      "import": "./dist/OrgChart.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tailwindcss -i src/styles.css -o src/_compiled.css --minify && tsup",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "showcase": "vite --config showcase/vite.config.ts",
    "showcase:build": "SHOWCASE_DEPLOY=docs vite build --config showcase/vite.config.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "peerDependencies": {
    "antd": "^6",
    "@ant-design/icons": "^6",
    "@mui/icons-material": "^9",
    "@mui/material": "^9",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@tanstack/react-query": "^5",
    "@xyflow/react": "^12",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "react-router": "^7 || ^8"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    },
    "@xyflow/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9",
    "@mui/material": "^9",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/react-query": "^5.62.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.11.2",
    "antd": "^6.6.8",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "dayjs": "^1.11.23"
  }
}
