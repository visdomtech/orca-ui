{
  "name": "@doublefin/orca-ui",
  "version": "1.1.1",
  "repository": "github:visdomtech/orca-ui",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./role-audit-prompt": {
      "types": "./dist/roleAuditPrompt.d.ts",
      "import": "./dist/roleAuditPrompt.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tailwindcss -i src/styles.css -o src/_compiled.css --minify && tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "peerDependencies": {
    "@mui/icons-material": "^9",
    "@mui/material": "^9",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@tanstack/react-query": "^5",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "react-router": "^7 || ^8"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9",
    "@mui/material": "^9",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/react-query": "^5.62.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0"
  }
}
