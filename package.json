{
  "name": "@doublefin/orca-ui",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "peerDependencies": {
    "@mui/icons-material": "^6",
    "@mui/material": "^6",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "react-router": "^7 || ^8"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6",
    "@mui/material": "^6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "tsup": "^8",
    "typescript": "^5.7.0"
  }
}
